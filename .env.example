NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_server_only
AKSA_ADMIN_EMAILS=owner@example.com

# Midtrans Snap. Keep MIDTRANS_SERVER_KEY private: never prefix it with NEXT_PUBLIC_.
MIDTRANS_SERVER_KEY=SB-Mid-server-your_sandbox_server_key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your_sandbox_client_key
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_SITE_URL=https://aksadigitalstudio.com

# Optional overrides. The app defaults to Rp199.000 and Rp499.000 respectively.
AKSA_PRICE_DIGITAL_INVITATION_IDR=199000
AKSA_PRICE_ORIGINAL_LOVE_SONG_IDR=499000
# AI Love Film is quoted manually (starting from Rp1.499.000), so keep it empty.
AKSA_PRICE_AI_LOVE_FILM_IDR=
